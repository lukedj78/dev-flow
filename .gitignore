# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Logs
*.log

# Build / temp
*.tmp
*.bak

# Skill workspace artifacts (per-iteration test outputs)
*-workspace/

# Mobile-related workspace artifacts (RN/Expo skills)
.expo/
.playwright-mcp/
ios/Pods/
android/.gradle/

# Local tool config / plugin cache
.claude/
.superpowers/

# Test screenshots in repo root (not source)
/*.png

# Skill bundles generated in root — official bundles live in dist/*.skill
/*.skill

# Obsidian: vault config IS committed (.obsidian/app.json, graph.json) so the
# ignore filters + graph colors are shared; personal window layout is not.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/
.obsidian/themes/

# Agent Plugins package: the manifest is tracked, the skill copies are generated
# (they would duplicate every skill file and double the diff of every edit).
/dist/agent-plugin/skills/

# Python build artefacts (pip install -e . leaves these)
*.egg-info/
