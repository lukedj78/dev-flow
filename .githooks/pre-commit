#!/usr/bin/env bash
# .githooks/pre-commit — keep the generated files in step with the skill sources.
#
# CI (lint-skills.yml) regenerates skills.json, rebuilds the docs/ site, checks the plugin
# manifests and compares the skill map's per-skill counts. Every one of those went red at
# least once because a SKILL.md changed and nobody re-ran the generators. This hook runs
# them when — and only when — a skill source is in the commit, repackages the bundles of the
# skills it touches, stages the results, and runs the linter so a red commit never leaves the
# machine.
#
# Enable once per clone:  ./scripts/install-git-hooks.sh   (sets core.hooksPath=.githooks)
# Skip for one commit:    SKIP_REGEN=1 git commit …        or   git commit --no-verify
#
# Note: the generators read the working tree, not the index. If a SKILL.md has unstaged
# edits on top of the staged ones, the regenerated files reflect the working tree.

set -euo pipefail

if [ "${SKIP_REGEN:-0}" = "1" ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACMRD)"
if ! grep -qE '(^|/)SKILL\.md$|/references/|/scripts/|^scripts/(build_|sync_skill_map\.py$|regenerate\.sh$)|^skills\.json$|^docs/dev-flow-skill-map\.html$' <<<"$staged"; then
  exit 0
fi

echo "[pre-commit] skill sources in this commit — regenerating registry, site, skill map, manifests…"
./scripts/regenerate.sh

git add skills.json docs/index.html docs/skills docs/dev-flow-skill-map.html \
        .claude-plugin/plugin.json dist/agent-plugin/plugin.json

# The .skill archives sit behind REGEN_BUNDLES in regenerate.sh, so nothing rebuilt them on a
# commit and they drifted: on 2026-10-03 twelve of fifty-one were wrong — six never built, and
# dev-flow's was short fifteen files, among them references/resources.md and before-you-build.md.
# Anyone installing from the committed bundle got a dev-flow without them.
#
# Rebuilding all 51 takes 0.4s, so speed was never the reason for the flag; the churn is — 51
# rewritten zips per commit. So rebuild only the skills this commit touches, which is both quiet
# and correct. A skill folder that was deleted keeps its stale bundle: remove that one by hand.
# `if`, not `[ … ] && echo`: under `set -e` a final directory without a SKILL.md would make the
# loop exit non-zero and take the whole hook down with it.
touched="$(awk -F/ 'NF > 1 { print $1 }' <<<"$staged" | sort -u | while read -r d; do
  if [ -f "$d/SKILL.md" ]; then echo "$d"; fi
done)"
if [ -n "$touched" ]; then
  echo "[pre-commit] repackaging $(wc -w <<<"$touched" | tr -d ' ') bundle(s): $(tr '\n' ' ' <<<"$touched")"
  # shellcheck disable=SC2086 — deliberate word splitting: one argument per skill name
  python3 scripts/build_skill_bundles.py $touched >/dev/null
  for d in $touched; do git add "dist/$d.skill"; done
fi

if ! python3 scripts/lint_skills.py; then
  echo
  echo "[pre-commit] ✗ lint failed — commit aborted. Fix the errors above, or bypass once with --no-verify."
  exit 1
fi

echo "[pre-commit] ✓ generated files staged, lint clean"
